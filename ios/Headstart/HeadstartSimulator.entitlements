<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- SIMULATOR / DEBUG ONLY. Nothing here is a capability; it is the minimum that
	     makes the KEYCHAIN work in an ad-hoc-signed build.

	     WHY IT EXISTS. With CODE_SIGNING_ALLOWED = NO the binary carries no entitlements
	     blob at all, and every `SecItemAdd` fails with -34018 ("A required entitlement
	     isn't present"). FirebaseAuth persists the signed-in user in the keychain, so
	     `Auth.signIn(with:)` reports FIRAuthErrorDomain 17995 / ERROR_KEYCHAIN_ERROR and
	     PHONE SIGN-IN CANNOT COMPLETE — observed, not theorised, on iPhone 17 Pro /
	     iOS 26.5 with Firebase 12.18.0. Ad-hoc signing (CODE_SIGN_IDENTITY "-") plus this
	     file gives the app a keychain access group and sign-in works.

	     It deliberately does NOT contain aps-environment or the time-sensitive key: those
	     are real capabilities that need a paid team to provision, and they live in
	     Headstart.entitlements, which the Release config uses. -->
	<key>application-identifier</key>
	<string>com.mutexdev.headstart</string>
	<key>keychain-access-groups</key>
	<array>
		<string>com.mutexdev.headstart</string>
	</array>
</dict>
</plist>
