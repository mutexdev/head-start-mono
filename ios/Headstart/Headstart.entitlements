<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Needs a paid Apple team to provision, which
	     M1 does not have; this file exists so a device build is one setting away.
	     Deliberately NOT wired into the Debug config (signing is off for the
	     simulator and a wired entitlements file trips ProcessProductPackaging). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Time Sensitive Notifications capability: what lets the server's
	     interruption-level: time-sensitive on the leadTime push break through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
