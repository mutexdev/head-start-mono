{
  "name": "headstart-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "jest",
    "emu:bootstrap": "node scripts/bootstrapEmulatorEnv.js",
    "emu:start": "npm run emu:bootstrap && npm run build && firebase emulators:start --only firestore,auth,functions --project fin-e8358",
    "emu:exec": "npm run emu:bootstrap && npm run build && firebase emulators:exec --only firestore,auth,functions --project fin-e8358",
    "test:emu": "npm run emu:exec -- \"jest -c jest.emulator.config.js\"",
    "drive": "npm run emu:exec -- \"node scripts/emuDrive.js --scenario=all\"",
    "drive:happy": "npm run emu:exec -- \"node scripts/emuDrive.js --scenario=happy\"",
    "deploy": "firebase deploy --only functions,firestore --project fin-e8358"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "firebase": "^12.18.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
